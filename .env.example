# Copy to .env.local and fill values printed by `npx supabase status`.
# Android emulators must use 10.0.2.2 instead of 127.0.0.1 for the host.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace_with_local_publishable_key

# Public Stripe test-mode key. The placeholder is enough for checks/builds.
STRIPE_PK=pk_test_placeholder_replace_me
